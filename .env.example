# Copy this file to .env only when local configuration is needed.
# Never commit real credentials.

EMAIL_ADDRESS=
APP_PASSWORD=
OPENAI_API_KEY=

# Trading safety defaults. Keep Live disabled.
AI_ASSET_ENABLE_IBKR_PAPER=false
AI_ASSET_ENABLE_LIVE_TRADING=false
AI_ASSET_LIVE_TRADING_UNLOCKED=false

# Paper operations monitoring. "auto" sends transition/cooldown alerts only
# when EMAIL_ADDRESS and APP_PASSWORD are configured locally.
IBKR_PAPER_MONITOR_EMAIL_ALERTS=auto
IBKR_PAPER_MONITOR_EMAIL_COOLDOWN_HOURS=12
IBKR_PAPER_MONITOR_MAX_RUNTIME_AGE_HOURS=96
IBKR_PAPER_MONITOR_MAX_HISTORY_BYTES=10485760
