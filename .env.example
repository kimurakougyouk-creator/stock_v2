# Copy this file to .env locally if needed. Never commit the real .env file.

# Optional AI integration
OPENAI_API_KEY=your_openai_api_key

# Optional Gmail notification integration
EMAIL_ADDRESS=your_email_address
APP_PASSWORD=your_gmail_app_password
TO_EMAIL=your_destination_email

# IBKR Paper Trading is opt-in and Live Trading remains disabled by default.
AI_ASSET_ENABLE_IBKR_PAPER=false
